# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
SKELETON_CACHE_TTL_SECONDS=86400
EXTRACTOR_LOCK_WAIT_SECONDS=90
EXTRACTOR_LOCK_TTL_SECONDS=120

# CUSTOM CLOUD CHROMIUM
# Run scripts/package_custom_chromium.sh before building Dockerfile.custom-chromium.
BAI_CHROME_BINARY=/opt/bai/chromium/chrome
BAI_USE_NATIVE_CHROME=auto
BAI_CHROME_TIMEOUT_SECONDS=25

# GROQ (for SLM in Phase 5)
GROQ_API_KEY=your_groq_key_here

# ANTHROPIC (for Claude API)
ANTHROPIC_API_KEY=your_anthropic_key_here

# APP
DEBUG=True
ENVIRONMENT=development
MIN_DESKTOP_VIEWPORT_WIDTH=0
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
