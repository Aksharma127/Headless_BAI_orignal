+void AppendBaiTelemetryJsonForNode(const Node& node,
+                                   int depth,
+                                   StringBuilder* json_output,
+                                   bool* first_node) {
+  LayoutObject* layout_object = node.GetLayoutObject();
+  if (layout_object) {
+    if (!*first_node) {
+      json_output->Append(',');
+    }
+    *first_node = false;
+
+    const gfx::Rect bounding_box = layout_object->AbsoluteBoundingBoxRect();
+    json_output->Append("{\"name\":\"");
+    // Escape the node name for JSON safety (do not include surrounding quotes).
+    std::string escaped_name;
+    base::EscapeJSONString(node.nodeName().Utf8(), false, &escaped_name);
+    // Copy into a uint8_t vector to avoid unsafe reinterpret_cast buffer usage.
+    std::vector<uint8_t> escaped_vec(escaped_name.begin(), escaped_name.end());
+    json_output->Append(String::FromUtf8(escaped_vec));
+    json_output->Append("\",\"depth\":");
+    json_output->AppendNumber(depth);
+    json_output->Append(",\"x\":");
+    json_output->AppendNumber(bounding_box.x());
+    json_output->Append(",\"y\":");
+    json_output->AppendNumber(bounding_box.y());
+    json_output->Append(",\"width\":");
+    json_output->AppendNumber(bounding_box.width());
+    json_output->Append(",\"height\":");
+    json_output->AppendNumber(bounding_box.height());
+    json_output->Append("}");
+  }
+
+  for (Node* child = node.firstChild(); child; child = child->nextSibling()) {
+    AppendBaiTelemetryJsonForNode(*child, depth + 1, json_output,
+                                  first_node);
+  }
+}
+
 }  // namespace
 
+void blink::LocalFrameView::DumpBaiTelemetryIfEnabled() {
+  std::cerr << "BAI_HOOK" << std::endl;
+
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "enable-bai-telemetry")) {
+    std::cerr << "BAI_SKIP: telemetry flag disabled" << std::endl;
+    return;
+  }
+
+  if (has_bai_dumped_) {
+    std::cerr << "BAI_SKIP: already dumped for this frame view" << std::endl;
+    return;
+  }
+
+  LocalFrame& frame = GetFrame();
+  if (!frame.IsLocalRoot()) {
+    std::cerr << "BAI_SKIP: not local root" << std::endl;
+    return;
+  }
+
+  Document* document = frame.GetDocument();
+  if (!document) {
+    std::cerr << "BAI_SKIP: no document" << std::endl;
+    return;
+  }
+
+  if (!document->IsLoadCompleted()) {
+    std::cerr << "BAI_SKIP: load not completed" << std::endl;
+    return;
+  }
+
+  if (!document->body()) {
+    std::cerr << "BAI_SKIP: no body" << std::endl;
+    return;
+  }
+
+  std::cerr << "BAI_BODY" << std::endl;
+
+  StringBuilder json_output;
+  json_output.Append("{\"nodes\":[");
+  bool first_node = true;
+  AppendBaiTelemetryJsonForNode(*document->body(), 0, &json_output,
+                                &first_node);
+  if (first_node) {
+    std::cerr << "BAI_SKIP: empty telemetry tree" << std::endl;
+    return;
+  }
+  json_output.Append("]}");
+
+  std::cerr << "\n=== BAI_SKELETON_START ===\n"
+            << json_output.ToString().Utf8()
+            << "\n=== BAI_SKELETON_END ===\n"
+            << std::endl;
+  has_bai_dumped_ = true;
+}
